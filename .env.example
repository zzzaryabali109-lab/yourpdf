# Adobe Developer Console > PDF Services API credentials (server only; needed for scanned PDF OCR)
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# Adobe-supported OCR locale; defaults to en-US.
PDF_SERVICES_OCR_LOCALE=en-US

# Self-Hosted Word-to-PDF Conversion Engine (Gotenberg / LibreOffice)
# Internal URL of private Gotenberg container (server-side only, never expose to client)
# In Docker Compose, this defaults to http://gotenberg:3000
# In local development, defaults to http://127.0.0.1:3000
GOTENBERG_URL=http://127.0.0.1:3000
